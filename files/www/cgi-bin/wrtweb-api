#!/usr/bin/lua
-- WrtWeb API backend (portable CGI).
-- Speaks JSON to the WrtWeb SPA. Uses only uci / ubus / iw / iwinfo,
-- so it works on OpenWrt 23.05 (opkg) and 24.10+/25.x (apk).
--
-- Route by query param c=<resource>. GET reads, POST mutates.
-- No external Lua deps; tiny built-in JSON encoder.

------------------------------------------------------------------
-- helpers
------------------------------------------------------------------
local function sh(cmd)
  local p = io.popen(cmd .. " 2>/dev/null")
  if not p then return "" end
  local out = p:read("*a") or ""
  p:close()
  return out
end

-- same as sh() but keeps stderr, so package managers can report a stale index
local function sh_err(cmd)
  local p = io.popen(cmd .. " 2>&1")
  if not p then return "" end
  local out = p:read("*a") or ""
  p:close()
  return out
end

local function trim(s)
  local r = (s or ""):gsub("^%s+",""):gsub("%s+$","")
  return r
end

local function uci_get(cfg, sec, opt)
  return trim(sh("uci -q get "..cfg.."."..sec.."."..opt))
end

local function uci_set(spec, val)
  return sh("uci set "..spec.."="..shq(val).." >/dev/null && echo ok")
end

function shq(s)
  s = tostring(s or "")
  return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function uci_commit(cfg) sh("uci commit "..cfg) end

-- UCI section names: letters, digits, underscore and dash
local function norm_name(s)
  return tostring(s or ""):gsub("[^%w%-_]", "")
end

-- what iwinfo reports in a scan -> the crypto name netifd expects
local function crypto_for(scan_enc)
  local e = (scan_enc or ""):upper()
  if e == "NONE" or e == "OPEN" or e == "OWE" then return "none" end
  if e:match("WPA3") and e:match("WPA2") then return "psk-mixed" end
  if e:match("WPA3") then return "sae" end
  if e:match("WPA2") then return "psk2" end
  if e:match("WPA") then return "psk" end
  return "psk2"
end

-- parse a UCI config into section -> option values
local function uci_sections(cfg)
  local secs = {}
  for line in sh("uci -q show " .. cfg):gmatch("[^\n]+") do
    local rest = line:match("^" .. cfg .. "%.(.+)$")
    if rest then
      -- an option line is "cfg.section.key=value"; a section line is "cfg.section=type"
      local sec, key, val = rest:match("^(.-)%.([%w_]+)=(.*)$")
      if not sec then sec, val = rest:match("^(.-)=(.*)$"); key = "type" end
      if sec then
        -- values are single-quoted; list values may hold several quoted items on one line
        val = (val:gsub("'", ""):gsub('"', ""))
        if not secs[sec] then secs[sec] = {} end
        if secs[sec][key] then secs[sec][key] = secs[sec][key] .. " " .. val
        else secs[sec][key] = val end
      end
    end
  end
  return secs
end

local UCI_TYPES = {
  zone = true, rule = true, redirect = true, defaults = true,
  forwarding = true, device = true, interface = true,
}

local function section_kind(name, s)
  if s.type then return s.type end
  local base = (name:gsub("@", ""):gsub("%[", ""):gsub("%]", ""):lower():match("^(%a+)")) or ""
  if UCI_TYPES[base] then return base end
  -- named sections do not carry their type in `uci show`, so infer from the keys
  if s.input or s.output or s.forward then return "zone" end
  if s.dest_ip or s.src_dport then return "redirect" end
  if s.src and s.target then return "rule" end
  return base
end

-- pairs() is unordered, so walk UCI sections in index order for stable output
local function sorted_names(secs)
  local names = {}
  for n in pairs(secs) do names[#names + 1] = n end
  local function idx(n) return tonumber(n:match("%[(%d+)%]")) or 10000 end
  table.sort(names, function(a, b)
    local ai, bi = idx(a), idx(b)
    if ai ~= bi then return ai < bi end
    return a < b
  end)
  return names
end

-- JSON encoder
local function json_escape(s)
  s = tostring(s)
  s = s:gsub('\\','\\\\'):gsub('"','\\"'):gsub('\n','\\n'):gsub('\r','\\r'):gsub('\t','\\t')
  s = s:gsub('[%z\1-\31]', function(c) return string.format('\\u%04x', c:byte()) end)
  return s
end

local function encode(v, depth)
  depth = depth or 0
  local t = type(v)
  if t == "nil" then return "null"
  elseif t == "boolean" then return v and "true" or "false"
  elseif t == "number" then
    if v ~= v then return "null" end
    return tostring(v)
  elseif t == "string" then return '"'..json_escape(v)..'"'
  elseif t == "table" then
    local isarr = true
    local n = 0
    for k,_ in pairs(v) do
      n = n + 1
      if type(k) ~= "number" then isarr = false end
    end
    if isarr and n > 0 then
      local parts = {}
      for i=1,n do parts[#parts+1] = encode(v[i], depth+1) end
      return "["..table.concat(parts, ",").."]"
    elseif n == 0 then
      return "{}"
    else
      local parts = {}
      for k,val in pairs(v) do
        parts[#parts+1] = '"'..json_escape(tostring(k))..'":'..encode(val, depth+1)
      end
      return "{"..table.concat(parts, ",").."}"
    end
  end
  return "null"
end

-- parse query string + form body into a table
local function parse_qs(s)
  local out = {}
  for k, v in (s or ""):gmatch("([^&=]+)=([^&=]*)") do
    -- form encoding: '+' is a space, so fold it before decoding %XX (a base64 key
    -- arrives as %2B and must keep its '+')
    out[k] = v:gsub("+", " "):gsub("%%(%x%x)", function(h) return string.char(tonumber(h,16)) end)
  end
  return out
end

local method = os.getenv("REQUEST_METHOD") or "GET"
local qs = parse_qs(os.getenv("QUERY_STRING"))
local body = ""
if method == "POST" then
  local len = tonumber(os.getenv("CONTENT_LENGTH") or "0") or 0
  if len > 0 then body = io.read(len) or "" end
  for k,v in pairs(parse_qs(body)) do qs[k] = v end
  -- also accept raw JSON body { ... } (flat keys)
  if body:match("^%s*{") then
    for k, v in body:gmatch('"([%w_]+)"%s*:%s*"([^"]*)"') do qs[k] = v end
    for k, v in body:gmatch('"([%w_]+)"%s*:%s*([%d%-%.]+)') do qs[k] = qs[k] or v end
  end
end

local function out(tbl)
  io.write("Content-Type: application/json\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")
  io.write(encode(tbl))
end

------------------------------------------------------------------
-- resources
------------------------------------------------------------------
local C = {}
local R = {}

-- status / overview
function R.overview()
  local model = trim(sh("cat /tmp/sysinfo/model"))
  local fw = trim(sh("grep DISTRIB_DESCRIPTION /etc/openwrt_release | cut -d= -f2 | tr -d \"'\""))
  local kernel = trim(sh("uname -r"))
  local host = trim(sh("cat /proc/sys/kernel/hostname"))
  local localtime = trim(sh("date '+%Y-%m-%d %H:%M:%S %Z'"))
  local up = tonumber(trim(sh("cut -d. -f1 /proc/uptime"))) or 0
  local load = trim(sh("cut -d' ' -f1-3 /proc/loadavg"))
  -- memory (KiB)
  local mi = {}
  for k,v in sh("cat /proc/meminfo"):gmatch("([%w_]+):%s*(%d+)") do mi[k]=tonumber(v) end
  local mt = mi.MemTotal or 0
  local mfree = mi.MemFree or 0
  local mavail = mi.MemAvailable or 0
  local mbuf = mi.Buffers or 0
  local mcache = mi.Cached or 0
  -- storage (KiB)
  local storage = {}
  for line in sh("df -k 2>/dev/null"):gmatch("[^\n]+") do
    local fs,size,used,avail,pct,mnt = line:match("^(%S+)%s+(%d+)%s+(%d+)%s+(%d+)%s+(%d+)%%%s+(.+)$")
    if fs and (mnt == "/" or mnt == "/overlay" or mnt == "/tmp" or mnt:match("^/mnt")) then
      storage[#storage+1] = { fs=fs, total=tonumber(size), used=tonumber(used), avail=tonumber(avail), pct=tonumber(pct), target=mnt }
    end
  end
  -- network (WAN)
  local function jf(q) return trim(sh("ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "..shq(q))) end
  local wan4 = jf('@["ipv4-address"][0].address')
  local wan6 = jf('@["ipv6-address"][0].address')
  local wanproto = jf('@.proto')
  if wanproto == "" then wanproto = trim(sh("uci -q get network.wan.proto")) end
  local wandev = jf('@.device'); if wandev == "" then wandev = "eth0" end
  local wanmac = trim(sh("cat /sys/class/net/"..wandev.."/address 2>/dev/null"))
  local wanup = tonumber(jf('@.uptime')) or 0
  -- netifd's status has no statistics section, so read the counters from sysfs
  local wanrx = tonumber(jf('@.statistics.rx_bytes')) or tonumber(sh("cat /sys/class/net/"..wandev.."/statistics/rx_bytes 2>/dev/null")) or 0
  local wantx = tonumber(jf('@.statistics.tx_bytes')) or tonumber(sh("cat /sys/class/net/"..wandev.."/statistics/tx_bytes 2>/dev/null")) or 0
  local wandns = jf('@["dns-server"][0]')
  -- dhcp leases
  local leases = {}
  for line in sh("cat /tmp/dhcp.leases 2>/dev/null"):gmatch("[^\n]+") do
    local exp,mac,ip,hn = line:match("^(%d+)%s+(%S+)%s+(%S+)%s+(%S+)")
    if mac then leases[#leases+1] = { expires=tonumber(exp), mac=mac, ip=ip, host=(hn == "*" and "" or hn) } end
  end
  -- wireless APs + station count
  local wl = {}
  local i = 0
  for sec in sh("uci show wireless"):gmatch("wireless%.([%w_]+)%.mode='ap'") do
    wl[#wl+1] = { ssid=uci_get("wireless",sec,"ssid"), radio=uci_get("wireless",sec,"device") }
    i = i + 1; if i > 8 then break end
  end
  local stations = 0
  for ifn in sh("iw dev 2>/dev/null"):gmatch("Interface (%S+)") do
    stations = stations + (tonumber(trim(sh("iw dev "..ifn.." station dump 2>/dev/null | grep -c Station"))) or 0)
  end
  -- temperatures from hwmon (millidegrees C); label Wi-Fi phy by its band
  local phy_band = {}
  for ifn in sh("iw dev 2>/dev/null"):gmatch("Interface (%S+)") do
    local info = sh("iw dev "..ifn.." info 2>/dev/null")
    local wiphy = tonumber(info:match("wiphy%s+(%d+)"))
    local ch = tonumber(info:match("channel%s+(%d+)"))
    if wiphy and ch then
      phy_band[wiphy] = (ch <= 14 and "2.4g") or (ch >= 32 and "5g") or nil
    end
  end
  local temps = {}
  for dir in sh("ls -d /sys/class/hwmon/hwmon* 2>/dev/null"):gmatch("[^\n]+") do
    local name = trim(sh("cat "..dir.."/name 2>/dev/null"))
    for f in sh("ls "..dir.." 2>/dev/null"):gmatch("(temp%d+_input)") do
      local raw = tonumber(trim(sh("cat "..dir.."/"..f.." 2>/dev/null")))
      if raw and raw > 0 then
        local key, label, order = "other", name, 3
        local lower = name:lower()
        if lower:match("cpu") or lower:match("soc") or lower:match("thermal") then
          key, label, order = "cpu", "CPU", 1
        else
          local phy = tonumber(name:match("phy(%d+)"))
          local band = phy and phy_band[phy]
          if band == "2.4g" then key, label, order = "wifi2g", "Wi-Fi 2.4G", 2
          elseif band == "5g" then key, label, order = "wifi5g", "Wi-Fi 5G", 2
          elseif phy then key, label, order = "wifi", name, 2 end
        end
        temps[#temps+1] = { key=key, name=label, sensor=name, c=math.floor(raw/100)/10, order=order }
      end
    end
  end
  table.sort(temps, function(a,b) return a.order < b.order end)
  local log = sh("logread -l 25 2>/dev/null")
  return {
    model=model, firmware=fw, kernel=kernel, hostname=host, localtime=localtime,
    uptime=up, load=load,
    mem_total=mt, mem_free=mfree, mem_avail=mavail, mem_buffers=mbuf, mem_cached=mcache,
    mem_used=(mt-mavail), mem_pct=(mt>0 and math.floor((mt-mavail)*100/mt) or 0),
    temps=temps,
    storage=storage,
    wan_ip=wan4, wan_ip6=wan6, wan_proto=wanproto, wan_mac=wanmac,
    wan_uptime=wanup, wan_rx=wanrx, wan_tx=wantx, wan_dns=wandns,
    clients=#leases, leases=leases, wireless=wl, stations=stations, log=log,
    -- legacy compact fields
    memtotal=math.floor(mt/1024), memfree=math.floor(mavail/1024),
  }
end

-- live wireless interfaces from `iw dev`: band, channel, width, tx power, stations
local function iw_ifaces()
  local out, cur = {}, nil
  for line in sh("iw dev 2>/dev/null"):gmatch("[^\n]+") do
    local ifn = line:match("Interface (%S+)")
    if ifn then
      cur = { iface = ifn, band = "", channel = 0, width = "", txpower = "", ssid = "" }
      out[ifn] = cur
    end
    if cur then
      local ch, freq, width = line:match("channel (%d+) %((%d+) MHz%), width: (%S+)")
      if ch then
        local f = tonumber(freq) or 0
        cur.band = (f >= 6000 and "6 GHz") or (f >= 4800 and "5 GHz") or "2.4 GHz"
        cur.channel = tonumber(ch) or 0
        cur.width = width or ""
      end
      local txp = line:match("txpower (%S+) dBm")
      if txp then cur.txpower = txp end
      local ssid = line:match("ssid (.*)")
      if ssid and ssid ~= "" then cur.ssid = ssid end
    end
  end
  for ifn, i in pairs(out) do
    local n = 0
    for line in sh("iw dev " .. ifn .. " station dump 2>/dev/null"):gmatch("[^\n]+") do
      if line:match("^Station ") then n = n + 1 end
    end
    i.stations = n
  end
  return out
end

-- clients list with connection method, band, signal and rates
function R.clients()
  -- wireless interfaces: band, channel, width, tx power
  local iface_info = iw_ifaces()

  local stations = {}
  for ifn in pairs(iface_info) do
    local cursta
    for line in sh("iw dev " .. ifn .. " station dump 2>/dev/null"):gmatch("[^\n]+") do
      local mac = line:match("Station (%x%x:[%x:]+)%s*%(on")
      if mac then
        cursta = { mac = mac:lower(), iface = ifn }
        stations[cursta.mac] = cursta
      elseif cursta then
        local s = line:match("signal:%s*(%-?%d+)")
        if s then cursta.signal = tonumber(s) end
        local tx = line:match("tx bitrate:%s*([%d%.]+) MBit/s")
        if tx then cursta.tx = tonumber(tx) end
        local rx = line:match("rx bitrate:%s*([%d%.]+) MBit/s")
        if rx then cursta.rx = tonumber(rx) end
        local ct = line:match("connected time:%s*(%d+)")
        if ct then cursta.connected = tonumber(ct) end
      end
    end
  end

  -- bridge forwarding table: which port each MAC was learned on
  local devmac, devname = {}, nil
  for line in sh("ip -d link show 2>/dev/null"):gmatch("[^\n]+") do
    local _, nm = line:match("^(%d+): ([^%s:]+)")
    if nm then devname = nm end
    local mac = line:match("link/ether (%S+)")
    if mac and devname and not devmac[mac:lower()] then devmac[mac:lower()] = devname end
  end
  local rows, portname, fdb = {}, {}, {}
  for line in sh("brctl showmacs br-lan 2>/dev/null"):gmatch("[^\n]+") do
    local pn, mac, flag = line:match("^%s*(%d+)%s+(%S+)%s+(%a+)")
    if pn and mac then rows[#rows + 1] = { pn = pn, mac = mac:lower(), flag = flag } end
  end
  for _, r in ipairs(rows) do
    if r.flag == "yes" then portname[r.pn] = devmac[r.mac] or ("port " .. r.pn) end
  end
  for _, r in ipairs(rows) do
    if r.flag == "no" then fdb[r.mac] = portname[r.pn] or ("port " .. r.pn) end
  end

  -- traffic per address from the conntrack table
  local traffic = {}
  for line in sh("cat /proc/net/nf_conntrack 2>/dev/null"):gmatch("[^\n]+") do
    local pair = {}
    for s, b in line:gmatch("src=(%S+)%s-.-bytes=(%d+)") do
      pair[#pair + 1] = { s, tonumber(b) or 0 }
    end
    if #pair == 2 then
      for _, p in ipairs(pair) do
        if not traffic[p[1]] then traffic[p[1]] = { up = 0, down = 0, conns = 0 } end
        traffic[p[1]].conns = traffic[p[1]].conns + 1
      end
      traffic[pair[1][1]].up = traffic[pair[1][1]].up + pair[1][2]
      traffic[pair[2][1]].down = traffic[pair[2][1]].down + pair[2][2]
    end
  end

  local list, bymac = {}, {}
  local function add(mac, ip, name, online)
    mac = mac:lower()
    local c = bymac[mac]
    if not c then
      c = { mac = mac, ip = ip, name = name, online = online }
      bymac[mac] = c; list[#list + 1] = c
    else
      if ip ~= "" and (c.ip or "") == "" then c.ip = ip end
      if name ~= "" and (c.name or "") == "" then c.name = name end
      if online then c.online = true end
    end
    return c
  end

  for line in sh("cat /tmp/dhcp.leases 2>/dev/null"):gmatch("[^\n]+") do
    local exp, mac, ip, host = line:match("(%d+)%s+(%S+)%s+(%S+)%s+(%S+)")
    if mac then add(mac, ip, (host == "*" and "" or host), true) end
  end
  local neigh = {}
  for ip, dev, mac, st in sh("ip neigh show 2>/dev/null"):gmatch("(%d+%.%d+%.%d+%.%d+)%s+dev%s+([%w%-]+)%s+lladdr%s+([%x:]+)%s+([A-Z]+)") do
    if dev:match("^br%-") or dev:match("^phy") or dev:match("^wlan") then
      neigh[ip] = { state = st, dev = dev }
      add(mac, ip, "", st ~= "FAILED")
    end
  end

  local wifi_n, wired_n = 0, 0
  for _, c in ipairs(list) do
    local w = stations[c.mac]
    if w then
      local info = iface_info[w.iface] or {}
      c.method = "wifi"; c.iface = w.iface
      c.band = info.band or ""; c.channel = info.channel or 0; c.width = info.width or ""
      c.signal = w.signal; c.tx = w.tx; c.rx = w.rx; c.connected = w.connected
      c.online = true
    else
      c.method = "wired"
      local p = fdb[c.mac]
      if p then
        c.port = p
        c.speed = trim(sh("cat /sys/class/net/" .. p .. "/speed 2>/dev/null"))
        c.duplex = trim(sh("cat /sys/class/net/" .. p .. "/duplex 2>/dev/null"))
        c.carrier = trim(sh("cat /sys/class/net/" .. p .. "/carrier 2>/dev/null"))
      end
    end
    if c.signal then
      c.quality = (c.signal >= -50 and "excellent") or (c.signal >= -60 and "good")
        or (c.signal >= -70 and "fair") or "weak"
    end
    if c.ip then
      c.traffic = traffic[c.ip]
      if neigh[c.ip] then c.state = neigh[c.ip].state end
    end
    if c.method == "wifi" then wifi_n = wifi_n + 1 elseif c.method == "wired" then wired_n = wired_n + 1 end
  end

  return { clients = list, total = #list, wifi = wifi_n, wired = wired_n }
end

-- wireless radios + ssids, matched to the live interface names netifd reports
function R.wireless()
  local iw = iw_ifaces()
  local status = sh("ubus call network.wireless status 2>/dev/null")
  local radios, ifaces = {}, {}
  for sec in sh("uci show wireless"):gmatch("wireless%.([%w_]+)=wifi%-device") do
    radios[#radios+1] = { name=sec, channel=uci_get("wireless",sec,"channel"),
      band=uci_get("wireless",sec,"band"), disabled=uci_get("wireless",sec,"disabled") }
  end
  for sec in sh("uci show wireless"):gmatch("wireless%.([%w_]+)%.mode='ap'") do
    local ssid = uci_get("wireless",sec,"ssid")
    local dev = uci_get("wireless",sec,"device")
    local live = nil
    -- netifd reports the interface name for each radio section; SSID match is the fallback
    if status ~= "" and dev ~= "" then
      local ifn = trim(sh("printf '%s' " .. shq(status) .. " | jsonfilter -e " .. shq("@." .. dev .. ".interfaces[0].ifname")))
      live = iw[ifn]
    end
    if not live then
      for _, i in pairs(iw) do if i.ssid == ssid then live = i break end end
    end
    ifaces[#ifaces+1] = { name=sec, ssid=ssid,
      key=uci_get("wireless",sec,"key"), encryption=uci_get("wireless",sec,"encryption"),
      device=dev, network=uci_get("wireless",sec,"network"),
      hidden=uci_get("wireless",sec,"hidden"),
      iface=(live and live.iface or ""), band=(live and live.band or ""),
      channel=(live and live.channel or 0), width=(live and live.width or ""),
      txpower=(live and live.txpower or ""), stations=(live and live.stations or 0) }
  end
  return { radios=radios, ifaces=ifaces }
end

function R.wireless_set()
  local sec = qs.iface or ""
  if sec == "" then return { ok=false, error="missing iface" } end
  if qs.ssid then uci_set("wireless."..sec..".ssid", qs.ssid) end
  if qs.key then uci_set("wireless."..sec..".key", qs.key) end
  if qs.encryption then uci_set("wireless."..sec..".encryption", qs.encryption) end
  if qs.channel and qs.radio then uci_set("wireless."..qs.radio..".channel", qs.channel) end
  if qs.hidden then uci_set("wireless."..sec..".hidden", qs.hidden) end
  uci_commit("wireless"); sh("wifi reload")
  return { ok=true }
end

-- WAN config (ethernet dhcp / pppoe / static)
function R.wan()
  local d = {
    proto = uci_get("network","wan","proto"),
    device = uci_get("network","wan","device"),
    username = uci_get("network","wan","username"),
    ipaddr = uci_get("network","wan","ipaddr"),
    netmask = uci_get("network","wan","netmask"),
    gateway = uci_get("network","wan","gateway"),
    dns = uci_get("network","wan","dns"),
    ip = trim(sh("ubus call network.interface.wan status | jsonfilter -e '@[\"ipv4-address\"][0].address'")),
  }
  return d
end

function R.wan_set()
  local proto = qs.proto or "dhcp"
  uci_set("network.wan.proto", proto)
  if proto == "pppoe" then
    if qs.username then uci_set("network.wan.username", qs.username) end
    if qs.password then uci_set("network.wan.password", qs.password) end
  elseif proto == "static" then
    if qs.ipaddr then uci_set("network.wan.ipaddr", qs.ipaddr) end
    if qs.netmask then uci_set("network.wan.netmask", qs.netmask) end
    if qs.gateway then uci_set("network.wan.gateway", qs.gateway) end
    if qs.dns then uci_set("network.wan.dns", qs.dns) end
  end
  uci_commit("network"); sh("ifup wan")
  return { ok=true }
end

-- Repeater: scan + join
function R.repeater_scan()
  local nets, seen = {}, {}
  for ifn in sh("iw dev"):gmatch("Interface (%S+)") do
    local out_s = sh("iwinfo "..ifn.." scan")
    local cur
    for line in out_s:gmatch("[^\n]+") do
      local cell = line:match("Cell %d+ %- Address: (%S+)")
      if cell then cur = { bssid=cell } end
      local essid = line:match('ESSID: "(.-)"')
      if essid and cur then cur.ssid = essid end
      local sig = line:match("Signal: (%-?%d+) dBm")
      if sig and cur then cur.signal = tonumber(sig) end
      local enc = line:match("Encryption: (%S+)")
      if enc and cur then
        cur.encryption = enc
        if cur.ssid and not seen[cur.ssid] then seen[cur.ssid]=true; nets[#nets+1]=cur end
        cur = nil
      end
    end
    if #nets > 0 then break end
  end
  return { networks=nets }
end

-- UCI section of the station (client) interface, its live interface name and radio
local function sta_iface()
  local sec, ifn, dev = "", "", ""
  for name in sh("uci show wireless"):gmatch("wireless%.([%w_]+)%.mode='sta'") do
    sec = name; dev = uci_get("wireless", name, "device") break
  end
  if sec ~= "" then
    for s, n in sh("ubus call network.wireless status 2>/dev/null"):gmatch(
        '"section"%s*:%s*"([^"]+)".-"ifname"%s*:%s*"([^"]+)"') do
      if s == sec then ifn = n break end
    end
  end
  return sec, ifn, dev
end

function R.repeater_status()
  local cfg = uci_sections("wrtweb")["repeater"] or {}
  local sec, ifn, dev = sta_iface()
  local out = { config = cfg, section = sec, iface = ifn, radio = dev,
                connected = false, bssid = "", signal = 0, quality = "",
                network = "", net_up = false, net_ip = "", uptime = 0,
                ap_same_radio = 0, watch_running = false }
  if ifn ~= "" then
    local bssid = trim(sh("iw dev " .. ifn .. " link 2>/dev/null"):match("Connected with (%S+)") or "")
    out.bssid = bssid; out.connected = bssid ~= ""
    local info = sh("iwinfo " .. ifn .. " info 2>/dev/null")
    out.quality = trim(info:match("Link Quality:%s*([^\n]+)") or "")
    out.signal = tonumber(info:match("Signal:%s*(%-?%d+)")) or 0
  end
  local net = uci_get("wireless", sec, "network") or "wwan"
  out.network = net
  if sec ~= "" then
    local j = sh("ubus call network.interface." .. net .. " status 2>/dev/null")
    local function jf(q) return trim(sh("printf '%s' " .. shq(j) .. " | jsonfilter -e " .. shq(q))) end
    out.net_up = jf("@.up") == "true"
    out.net_ip = jf('@["ipv4-address"][0].address')
    out.uptime = tonumber(jf("@.uptime")) or 0
  end
  for name in sh("uci show wireless"):gmatch("wireless%.([%w_]+)%.mode='ap'") do
    if uci_get("wireless", name, "device") == dev then out.ap_same_radio = out.ap_same_radio + 1 end
  end
  local pid = trim(sh("cat /tmp/wrtweb-repeater.pid 2>/dev/null"))
  out.watch_running = pid ~= "" and sh("kill -0 " .. pid .. " 2>/dev/null && echo yes") == "yes"
  return out
end

function R.repeater_join()
  local ssid = qs.ssid or ""
  if ssid == "" then return { ok=false, error="missing ssid" } end
  local enc = crypto_for(qs.encryption or "psk2")
  local _, _, dev = sta_iface()
  local radio = qs.radio or ""
  if radio == "" then radio = dev end
  if radio == "" then
    for name in sh("uci show wireless"):gmatch("wireless%.([%w_]+)=wifi%-device") do radio = name break end
  end

  uci_set("wrtweb.repeater.enabled", "1")
  uci_set("wrtweb.repeater.mode", "client")
  uci_set("wrtweb.repeater.ssid", ssid)
  if (qs.key or "") ~= "" then uci_set("wrtweb.repeater.key", qs.key) end
  uci_set("wrtweb.repeater.encryption", enc)
  uci_set("wrtweb.repeater.radio", radio)
  if (qs.bssid or "") ~= "" then uci_set("wrtweb.repeater.bssid", qs.bssid) end
  if qs.auto ~= "" then uci_set("wrtweb.repeater.auto", qs.auto) end
  uci_commit("wrtweb")

  -- the helper writes the station interface, applies it and starts the watchdog
  local msg = trim(sh("sh /usr/libexec/wrtweb/repeater.sh apply 2>/dev/null"))
  return { ok = (msg:match("^ok") ~= nil), message = msg, encryption = enc }
end

function R.repeater_action()
  local act = qs.action or ""
  local sec, ifn, _ = sta_iface()
  if sec == "" then return { ok=false, error="no station interface" } end
  local net = uci_get("wireless", sec, "network") or "wwan"
  if act == "reconnect" then
    sh("ifdown " .. net .. " 2>/dev/null")
    sh("sleep 2 2>/dev/null")
    if ifn ~= "" and sh("command -v wpa_cli") ~= "" then
      sh("wpa_cli -i " .. ifn .. " reassociate >/dev/null 2>&1")
    end
    sh("wifi reload 2>/dev/null")
    sh("ifup " .. net .. " 2>/dev/null")
    return { ok=true }
  elseif act == "stop" then
    uci_set("wrtweb.repeater.enabled", "0")
    uci_set("wireless." .. sec .. ".disabled", "1")
    uci_commit("wrtweb"); uci_commit("wireless")
    sh("ifdown " .. net .. " 2>/dev/null")
    sh("wifi reload 2>/dev/null")
    local pid = trim(sh("cat /tmp/wrtweb-repeater.pid 2>/dev/null"))
    if pid ~= "" then sh("kill " .. pid .. " 2>/dev/null"); sh("rm -f /tmp/wrtweb-repeater.pid") end
    return { ok=true }
  end
  return { ok=false, error="unknown action" }
end


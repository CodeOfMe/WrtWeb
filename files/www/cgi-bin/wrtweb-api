-- Tailscale status
function R.tailscale()
  return {
    installed = trim(sh("command -v tailscale")) ~= "",
    backend = trim(sh("tailscale status --json 2>/dev/null | jsonfilter -e '@.BackendState'")),
    ip = trim(sh("tailscale ip -4 2>/dev/null")),

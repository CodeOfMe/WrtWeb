-- Firewall port forwards
function R.portforward()
  local list = {}
  local i = 0
  while true do
    local nm = uci_get("firewall", "@redirect["..i.."]", "name")
    local tgt = uci_get("firewall", "@redirect["..i.."]", "dest_ip")
    if tgt == "" and nm == "" then
      local proto = uci_get("firewall", "@redirect["..i.."]", "proto")
      if proto == "" then break end
    end
    list[#list+1] = {
      idx=i, name=nm,
      proto=uci_get("firewall","@redirect["..i.."]","proto"),
      src_dport=uci_get("firewall","@redirect["..i.."]","src_dport"),
      dest_ip=uci_get("firewall","@redirect["..i.."]","dest_ip"),
      dest_port=uci_get("firewall","@redirect["..i.."]","dest_port"),
    }
    i = i + 1
    if i > 64 then break end
  end
  return { rules=list }
end

function R.portforward_add()
  sh("uci add firewall redirect >/dev/null")
  uci_set("firewall.@redirect[-1].name", qs.name or "fwd")
  uci_set("firewall.@redirect[-1].target", "DNAT")
  uci_set("firewall.@redirect[-1].src", "wan")
  uci_set("firewall.@redirect[-1].proto", qs.proto or "tcp")
  uci_set("firewall.@redirect[-1].src_dport", qs.src_dport or "")
  uci_set("firewall.@redirect[-1].dest_ip", qs.dest_ip or "")
  uci_set("firewall.@redirect[-1].dest_port", qs.dest_port or qs.src_dport or "")
  uci_commit("firewall"); sh("/etc/init.d/firewall reload")
  return { ok=true }
end

function R.portforward_del()
  local idx = qs.idx
  if not idx then return { ok=false } end
  sh("uci delete firewall.@redirect["..idx.."]")
  uci_commit("firewall"); sh("/etc/init.d/firewall reload")
  return { ok=true }
end

-- AdGuard Home
function R.adguard()
  local running = sh("pidof AdGuardHome | head -1")
  local en = trim(sh("[ -x /etc/init.d/adguardhome ] && /etc/init.d/adguardhome enabled && echo 1 || echo 0"))
  return { installed = (sh("command -v AdGuardHome")~="" and true or false) or (sh("ls /usr/bin/AdGuardHome /usr/sbin/AdGuardHome 2>/dev/null")~=""),
           running = (running ~= ""), enabled = en, port = 3000 }
end

function R.adguard_set()
  local act = qs.action or "status"
  if act == "start" then sh("/etc/init.d/adguardhome start; /etc/init.d/adguardhome enable")
  elseif act == "stop" then sh("/etc/init.d/adguardhome stop; /etc/init.d/adguardhome disable") end
  return { ok=true }
end

-- NAS / Samba
function R.nas()
  local shares = {}
  for line in sh("uci show samba 2>/dev/null"):gmatch("[^\n]+") do
    local sec = line:match("samba%.([%w_]+)%.path='(.-)'")
    if sec then shares[#shares+1] = { name=sec, path=line:match("path='(.-)'") } end
  end
  local mounts = trim(sh("mount | grep -E '/dev/sd|/dev/nvme' | awk '{print $1\" -> \"$3}'"))
  return { samba_enabled = trim(sh("[ -x /etc/init.d/samba4 ] && /etc/init.d/samba4 enabled && echo 1")),
           shares=shares, mounts=mounts }
end

function R.nas_set()
  if qs.enabled == "1" then
    -- ensure an authenticated share over /mnt exists
    if trim(sh("uci -q get samba4.@sambashare[0].path")) == "" then
      sh("uci add samba4 sambashare")
      uci_set("samba4.@sambashare[-1].name", "share")
      uci_set("samba4.@sambashare[-1].path", "/mnt")
      uci_set("samba4.@sambashare[-1].read_only", "no")
      uci_set("samba4.@sambashare[-1].guest_ok", "no")
      uci_set("samba4.@sambashare[-1].create_mask", "0666")
      uci_set("samba4.@sambashare[-1].dir_mask", "0777")
      uci_commit("samba4")
    end
    sh("/etc/init.d/samba4 enable 2>/dev/null; /etc/init.d/samba4 restart 2>/dev/null")
    sh("/etc/init.d/samba enable 2>/dev/null; /etc/init.d/samba restart 2>/dev/null")
  elseif qs.enabled == "0" then
    sh("/etc/init.d/samba4 stop 2>/dev/null; /etc/init.d/samba4 disable 2>/dev/null")
  end
  return { ok=true }
end

-- Samba user management (+ per-user storage location)
local function find_share(name)
  local i = 0
  while i <= 64 do
    local nm = uci_get("samba4", "@sambashare["..i.."]", "name")
    if nm == "" then return nil end
    if nm == name then return i end
    i = i + 1
  end
  return nil
end

local function assign_share(u, p)
  sh("mkdir -p "..shq(p).." 2>/dev/null")
  sh("chown -R "..shq(u)..":"..shq(u).." "..shq(p).." 2>/dev/null")
  local idx = find_share(u)
  if idx then
    uci_set("samba4.@sambashare["..idx.."].path", p)
    uci_set("samba4.@sambashare["..idx.."].users", u)
  else
    sh("uci add samba4 sambashare")
    uci_set("samba4.@sambashare[-1].name", u)
    uci_set("samba4.@sambashare[-1].path", p)
    uci_set("samba4.@sambashare[-1].users", u)
    uci_set("samba4.@sambashare[-1].read_only", "no")
    uci_set("samba4.@sambashare[-1].guest_ok", "no")
    uci_set("samba4.@sambashare[-1].create_mask", "0666")
    uci_set("samba4.@sambashare[-1].dir_mask", "0777")
  end
  uci_commit("samba4")
  sh("/etc/init.d/samba4 restart >/dev/null 2>&1")
end

local function default_path(u)
  if trim(sh("[ -d /mnt/nvme ] && echo y")) == "y" then return "/mnt/nvme/"..u end
  return "/mnt/"..u
end

function R.samba_users()
  local users = {}
  for line in sh("pdbedit -L 2>/dev/null"):gmatch("[^\n]+") do
    local u = line:match("^([^:]+):")
    if u and u ~= "" then
      local idx = find_share(u)
      local path = idx and uci_get("samba4", "@sambashare["..idx.."]", "path") or ""
      users[#users+1] = { name = u, path = path }
    end
  end
  return { users = users }
end

function R.samba_user_add()
  local u = qs.user or ""
  local p = qs.pass or ""
  if not u:match("^[%w_%-]+$") or #u > 32 then return { ok=false, error="bad username" } end
  if #p < 5 then return { ok=false, error="password too short (min 5)" } end
  if trim(sh("id -u "..shq(u).." 2>/dev/null")) == "" then
    sh("useradd -M -s /bin/false -U "..shq(u).." >/dev/null 2>&1")
  end
  local out = sh("printf '%s\\n%s\\n' "..shq(p).." "..shq(p).." | smbpasswd -a -s "..shq(u).." 2>&1")
  local cnt = trim(sh("pdbedit -L 2>/dev/null | grep -c '^"..u..":'"))
  local ok = (cnt ~= "" and cnt ~= "0")
  if ok then
    local path = qs.path or ""
    if path == "" then path = default_path(u) end
    assign_share(u, path)
  end
  sh("/etc/init.d/samba4 restart >/dev/null 2>&1")
  return { ok = ok, output = out }
end

function R.samba_assign()
  local u = qs.user or ""
  local p = qs.path or ""
  if not u:match("^[%w_%-]+$") then return { ok=false, error="bad user" } end
  if not p:match("^/mnt/[%w%._/%-]+$") or p:find("%.%.") then
    return { ok=false, error="path must be under /mnt" }
  end
  if trim(sh("id -u "..shq(u).." 2>/dev/null")) == "" then return { ok=false, error="user not found" } end
  assign_share(u, p)
  return { ok=true, path=p }
end

function R.samba_user_del()
  local u = qs.user or ""
  if not u:match("^[%w_%-]+$") then return { ok=false } end
  local idx = find_share(u)
  if idx then sh("uci delete samba4.@sambashare["..idx.."]"); uci_commit("samba4") end
  sh("smbpasswd -x "..shq(u).." >/dev/null 2>&1")
  sh("userdel "..shq(u).." >/dev/null 2>&1")
  sh("/etc/init.d/samba4 restart >/dev/null 2>&1")
  return { ok=true }
end

-- DDNS
function R.ddns()
  local list = {}
  local i = 0
  while true do
    local svc = uci_get("ddns", "@service["..i.."]", "service_name")
    local dom = uci_get("ddns", "@service["..i.."]", "domain")
    local en = uci_get("ddns", "@service["..i.."]", "enabled")
    if svc == "" and dom == "" and en == "" then break end
    list[#list+1] = { idx=i, service=svc, domain=dom, enabled=en }
    i = i + 1
    if i > 32 then break end
  end
  return { services=list }
end


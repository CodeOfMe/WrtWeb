local c = qs.c or "overview"
local handler = R[c]
if not handler then
  out({ ok=false, error="unknown resource: "..c })
  os.exit(0)
end
local ok, res = pcall(handler)
if not ok then
  out({ ok=false, error=tostring(res) })
else
  out(res)
end

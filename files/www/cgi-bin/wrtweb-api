-- DNS upstream config
function R.dns()
  return {
    servers = sh("uci -q get dhcp.@dnsmasq[0].server 2>/dev/null"),
    resolv = sh("grep nameserver /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null"),
  }
end

function R.dns_set()
  if qs.servers ~= nil then
    sh("uci -q delete dhcp.@dnsmasq[0].server")
    for s in tostring(qs.servers):gmatch("[^%s,]+") do
      if s:match("^[%d%.]+$") then sh("uci add_list dhcp.@dnsmasq[0].server="..shq(s)) end
    end
    uci_commit("dhcp"); sh("/etc/init.d/dnsmasq restart")
  end
  return { ok=true }
end

-- OpenVPN profile listing
function R.ovpn()
  return { files = trim(sh("ls /etc/openvpn/*.ovpn /etc/openvpn/*.conf 2>/dev/null")) }
end

-- Remote WrtWeb access from the WAN side (e.g. hosts on 192.168.100.0/24)
local REMOTE_RULE = "Allow-WrtWeb-WAN"
local function find_remote_rule()
  for sec, name in sh("uci show firewall 2>/dev/null"):gmatch("firewall%.([^%.]+)%.name='([^']*)'") do
    if name == REMOTE_RULE then return sec end
  end
  return nil
end

function R.remote_access()
  local sec = find_remote_rule()
  local wanip = trim(sh("ubus call network.interface.wan status | jsonfilter -e '@[\"ipv4-address\"][0].address'"))
  return { enabled = (sec ~= nil), wan_ip = wanip }
end

function R.remote_access_set()
  local sec = find_remote_rule()
  if qs.enabled == "1" then
    if not sec then
      sh("uci add firewall rule")
      uci_set("firewall.@rule[-1].name", REMOTE_RULE)
      uci_set("firewall.@rule[-1].src", "wan")
      uci_set("firewall.@rule[-1].src_ip", "192.168.100.0/24")
      uci_set("firewall.@rule[-1].proto", "tcp")
      uci_set("firewall.@rule[-1].dest_port", "80 443")
      uci_set("firewall.@rule[-1].target", "ACCEPT")
      uci_commit("firewall")
    end
    uci_set("uhttpd.main.rfc1918_filter", "0"); uci_commit("uhttpd")
  else
    if sec then sh("uci delete firewall."..sec); uci_commit("firewall") end
    uci_set("uhttpd.main.rfc1918_filter", "1"); uci_commit("uhttpd")
  end
  sh("/etc/init.d/firewall reload >/dev/null 2>&1")
  sh("(sleep 2; /etc/init.d/uhttpd restart) >/dev/null 2>&1 &")
  return { ok=true }
end

-- System: language / timezone / upgrade / backup / reboot / logs
function R.system()
  return {
    lang = uci_get("luci","main","lang"),
    timezone = trim(sh("cat /etc/TZ 2>/dev/null; uci -q get system.@system[0].timezone")),
    hostname = uci_get("system","@system[0]","hostname"),
  }
end

function R.system_set()
  if qs.lang then uci_set("luci.main.lang", qs.lang); uci_commit("luci") end
  if qs.hostname then uci_set("system.@system[0].hostname", qs.hostname); uci_commit("system") end
  if qs.timezone then uci_set("system.@system[0].timezone", qs.timezone); uci_commit("system") end
  return { ok=true }
end

function R.logs()
  return { syslog = sh("logread -l 200 2>/dev/null") }
end

function R.reboot()
  if qs.confirm == "1" then sh("(sleep 1; reboot) >/dev/null 2>&1 &") end
  return { ok=true }
end

function R.backup()
  return { note = "use /cgi-bin/wrtweb-api?c=backup_download" }
end

function R.plugins()
  local pkgs = {}
  local raw = sh("apk list --installed 2>/dev/null || opkg list-installed 2>/dev/null")
  for line in raw:gmatch("[^\n]+") do
    local name = line:match("^(%S+)")
    if name then pkgs[#pkgs+1] = name end
  end
  return { packages = pkgs, count = #pkgs }
end

-- network interface status
function R.network()
  local ifaces = {}
  for name in sh("ubus list 'network.interface.*'"):gmatch("network%.interface%.([%w_]+)") do
    local up = trim(sh("ubus call network.interface."..name.." status | jsonfilter -e '@.up'"))
    local ip = trim(sh("ubus call network.interface."..name.." status | jsonfilter -e '@[\"ipv4-address\"][0].address'"))
    ifaces[#ifaces+1] = { name=name, up=(up=="true"), ip=ip }
  end
  return { interfaces=ifaces }
end


-- Package mirror source selection (TUNA / USTC / official)
local function mirror_file()
  local f = "/etc/apk/repositories.d/distfeeds.list"
  if trim(sh("test -f "..f.." && echo y")) ~= "y" then f = "/etc/apk/repositories" end
  return f
end

function R.mirror()
  local f = mirror_file()
  local first = trim(sh("head -1 "..f))
  local host = first:match("^[a-zA-Z]+://([^/]+)") or ""
  return { host = host, file = f,
           opkg = (sh("command -v opkg") ~= "") }
end

function R.mirror_set()
  local mode = qs.mode or "auto"
  if not mode:match("^[a-z]+$") then return { ok=false, error="bad mode" } end
  if mode ~= "auto" and mode ~= "tuna" and mode ~= "ustc" and mode ~= "official" then
    return { ok=false, error="bad mode" }
  end
  local out = sh("/usr/libexec/wrtweb/mirror.sh "..mode.." 2>&1")
  return { ok = (out:match("^OK") ~= nil), output = out, mode = mode }
end

-- Service status + control for feature daemons
local SERVICES = {
  tor       = { proc="tor",          svc="tor",          check="command -v tor" },
  tailscale = { proc="tailscaled",   svc="tailscale",    check="command -v tailscale" },
  zerotier  = { proc="zerotier-one", svc="zerotier",     check="command -v zerotier-cli" },
  mwan3     = { proc="",             svc="mwan3",        check="command -v mwan3" },
  openvpn   = { proc="openvpn",      svc="openvpn",      check="command -v openvpn" },
  wireguard = { proc="",             svc="",             check="command -v wg" },
  adguard   = { proc="AdGuardHome",  svc="adguardhome",  check="command -v AdGuardHome" },
  samba     = { proc="smbd",         svc="samba4",       check="command -v smbd" },
  mihomo    = { proc="mihomo",       svc="mihomo",       check="command -v mihomo" },
}

function R.service()
  local k = qs.s or ""
  local d = SERVICES[k] or {}
  local installed = d.check and trim(sh(d.check)) ~= "" or false
  local running = d.proc and d.proc ~= "" and trim(sh("pidof "..d.proc)) ~= "" or false
  return { key=k, installed=installed, running=running }
end

function R.service_set()
  local k = qs.s or ""
  local act = qs.action or "status"
  local d = SERVICES[k] or {}
  if not d.svc or d.svc == "" then return { ok=false, error="no service" } end
  if act == "start" then
    sh("/etc/init.d/"..d.svc.." start 2>/dev/null; /etc/init.d/"..d.svc.." enable 2>/dev/null")
  elseif act == "stop" then
    sh("/etc/init.d/"..d.svc.." stop 2>/dev/null")
  elseif act == "restart" then
    sh("/etc/init.d/"..d.svc.." restart 2>/dev/null")
  end
  return { ok=true }
end


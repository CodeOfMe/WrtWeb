local C = {}
local R = {}

-- status / overview
function R.overview()
  local model = trim(sh("cat /tmp/sysinfo/model"))
  local fw = trim(sh("grep DISTRIB_DESCRIPTION /etc/openwrt_release | cut -d= -f2 | tr -d \"'\""))
  local kernel = trim(sh("uname -r"))
  local host = trim(sh("cat /proc/sys/kernel/hostname"))
  local localtime = trim(sh("date '+%Y-%m-%d %H:%M:%S %Z'"))
  local up = tonumber(trim(sh("cut -d. -f1 /proc/uptime"))) or 0
  local load = trim(sh("cut -d' ' -f1-3 /proc/loadavg"))
  -- memory (KiB)
  local mi = {}
  for k,v in sh("cat /proc/meminfo"):gmatch("([%w_]+):%s*(%d+)") do mi[k]=tonumber(v) end
  local mt = mi.MemTotal or 0
  local mfree = mi.MemFree or 0
  local mavail = mi.MemAvailable or 0
  local mbuf = mi.Buffers or 0
  local mcache = mi.Cached or 0
  -- storage (KiB)
  local storage = {}
  for line in sh("df -k 2>/dev/null"):gmatch("[^\n]+") do
    local fs,size,used,avail,pct,mnt = line:match("^(%S+)%s+(%d+)%s+(%d+)%s+(%d+)%s+(%d+)%%%s+(.+)$")
    if fs and (mnt == "/" or mnt == "/overlay" or mnt == "/tmp" or mnt:match("^/mnt")) then
      storage[#storage+1] = { fs=fs, total=tonumber(size), used=tonumber(used), avail=tonumber(avail), pct=tonumber(pct), target=mnt }
    end
  end
  -- network (WAN)
  local function jf(q) return trim(sh("ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "..shq(q))) end
  local wan4 = jf('@["ipv4-address"][0].address')
  local wan6 = jf('@["ipv6-address"][0].address')
  local wanproto = jf('@.proto')
  if wanproto == "" then wanproto = trim(sh("uci -q get network.wan.proto")) end
  local wandev = jf('@.device'); if wandev == "" then wandev = "eth0" end
  local wanmac = trim(sh("cat /sys/class/net/"..wandev.."/address 2>/dev/null"))
  local wanup = tonumber(jf('@.uptime')) or 0
  local wanrx = tonumber(jf('@.statistics.rx_bytes')) or 0
  local wantx = tonumber(jf('@.statistics.tx_bytes')) or 0
  local wandns = jf('@["dns-server"][0]')
  -- dhcp leases
  local leases = {}
  for line in sh("cat /tmp/dhcp.leases 2>/dev/null"):gmatch("[^\n]+") do
    local exp,mac,ip,hn = line:match("^(%d+)%s+(%S+)%s+(%S+)%s+(%S+)")
    if mac then leases[#leases+1] = { expires=tonumber(exp), mac=mac, ip=ip, host=(hn == "*" and "" or hn) } end
  end
  -- wireless APs + station count
  local wl = {}
  local i = 0
  for sec in sh("uci show wireless"):gmatch("wireless%.([%w_]+)%.mode='ap'") do
    wl[#wl+1] = { ssid=uci_get("wireless",sec,"ssid"), radio=uci_get("wireless",sec,"device") }
    i = i + 1; if i > 8 then break end
  end
  local stations = 0
  for ifn in sh("iw dev 2>/dev/null"):gmatch("Interface (%S+)") do
    stations = stations + (tonumber(trim(sh("iw dev "..ifn.." station dump 2>/dev/null | grep -c Station"))) or 0)
  end
  local log = sh("logread -l 25 2>/dev/null")
  return {
    model=model, firmware=fw, kernel=kernel, hostname=host, localtime=localtime,
    uptime=up, load=load,
    mem_total=mt, mem_free=mfree, mem_avail=mavail, mem_buffers=mbuf, mem_cached=mcache,
    mem_used=(mt-mavail), mem_pct=(mt>0 and math.floor((mt-mavail)*100/mt) or 0),
    storage=storage,
    wan_ip=wan4, wan_ip6=wan6, wan_proto=wanproto, wan_mac=wanmac,
    wan_uptime=wanup, wan_rx=wanrx, wan_tx=wantx, wan_dns=wandns,
    clients=#leases, leases=leases, wireless=wl, stations=stations, log=log,
    -- legacy compact fields
    memtotal=math.floor(mt/1024), memfree=math.floor(mavail/1024),
  }
end

-- clients list with connection method, band, signal and rates
function R.clients()
  local wifi = {}
  local iface_band = {}
  for ifn in sh("iw dev 2>/dev/null"):gmatch("Interface (%S+)") do
    local info = sh("iw dev "..ifn.." info 2>/dev/null")
    local ch = tonumber(info:match("channel%s+(%d+)")) or 0
    iface_band[ifn] = (ch > 0 and ch <= 14 and "2.4g") or (ch >= 32 and "5g") or ""
    local cur
    for line in sh("iw dev "..ifn.." station dump 2>/dev/null"):gmatch("[^\n]+") do
      local mac = line:match("Station (%x%x:[%x:]+)%s*%(on")
      if mac then
        cur = { mac=mac:lower(), iface=ifn }
        wifi[cur.mac] = cur
      elseif cur then
        local s = line:match("signal:%s*(%-?%d+)")
        if s then cur.signal = tonumber(s) end
        local tx = line:match("tx bitrate:%s*([%d%.]+) MBit/s")
        if tx then cur.tx = tonumber(tx) end
        local rx = line:match("rx bitrate:%s*([%d%.]+) MBit/s")
        if rx then cur.rx = tonumber(rx) end
        local ct = line:match("connected time:%s*(%d+)")
        if ct then cur.connected = tonumber(ct) end
      end
    end
  end

  local list, bymac = {}, {}
  local function add(mac, ip, name, online)
    mac = mac:lower()
    local c = bymac[mac]
    if not c then
      c = { mac=mac, ip=ip, name=name, online=online }
      bymac[mac] = c; list[#list+1] = c
    else
      if ip ~= "" and (c.ip or "") == "" then c.ip = ip end
      if name ~= "" and (c.name or "") == "" then c.name = name end
      if online then c.online = true end
    end
    return c
  end

  for line in sh("cat /tmp/dhcp.leases 2>/dev/null"):gmatch("[^\n]+") do
    local exp, mac, ip, host = line:match("(%d+)%s+(%S+)%s+(%S+)%s+(%S+)")
    if mac then add(mac, ip, (host == "*" and "" or host), true) end
  end
  for ip, dev, mac in sh("ip neigh 2>/dev/null"):gmatch("(%d+%.%d+%.%d+%.%d+)%s+dev%s+(%S+)%s+lladdr%s+(%x%x:[%x:]+)") do
    if dev:match("^br%-") or dev:match("^phy") or dev:match("^wlan") then
      add(mac, ip, "", true)
    end
  end

  for _, c in ipairs(list) do
    local w = wifi[c.mac]
    if w then
      c.method = "wifi"; c.iface = w.iface; c.band = iface_band[w.iface] or ""
      c.signal = w.signal; c.tx = w.tx; c.rx = w.rx; c.connected = w.connected; c.online = true
    else
      c.method = "wired"
    end
  end
  for mac, w in pairs(wifi) do
    if not bymac[mac] then
      list[#list+1] = { mac=mac, ip="", name="", online=true, method="wifi",
        iface=w.iface, band=iface_band[w.iface] or "", signal=w.signal, tx=w.tx, rx=w.rx, connected=w.connected }
    end
  end
  return { clients=list }
end

-- wireless radios + ssids
function R.wireless()
  local radios, ifaces = {}, {}
  for sec in sh("uci show wireless"):gmatch("wireless%.([%w_]+)=wifi%-device") do
    radios[#radios+1] = { name=sec, channel=uci_get("wireless",sec,"channel"),
      band=uci_get("wireless",sec,"band"), disabled=uci_get("wireless",sec,"disabled") }
  end
  for sec in sh("uci show wireless"):gmatch("wireless%.([%w_]+)%.mode='ap'") do
    ifaces[#ifaces+1] = { name=sec, ssid=uci_get("wireless",sec,"ssid"),
      key=uci_get("wireless",sec,"key"), encryption=uci_get("wireless",sec,"encryption"),
      device=uci_get("wireless",sec,"device"), network=uci_get("wireless",sec,"network"),
      hidden=uci_get("wireless",sec,"hidden") }
  end
  return { radios=radios, ifaces=ifaces }
end

function R.wireless_set()
  local sec = qs.iface or ""
  if sec == "" then return { ok=false, error="missing iface" } end
  if qs.ssid then uci_set("wireless."..sec..".ssid", qs.ssid) end
  if qs.key then uci_set("wireless."..sec..".key", qs.key) end
  if qs.encryption then uci_set("wireless."..sec..".encryption", qs.encryption) end
  if qs.channel and qs.radio then uci_set("wireless."..qs.radio..".channel", qs.channel) end
  if qs.hidden then uci_set("wireless."..sec..".hidden", qs.hidden) end
  uci_commit("wireless"); sh("wifi reload")
  return { ok=true }
end

-- WAN config (ethernet dhcp / pppoe / static)
function R.wan()
  local d = {
    proto = uci_get("network","wan","proto"),
    device = uci_get("network","wan","device"),
    username = uci_get("network","wan","username"),
    ipaddr = uci_get("network","wan","ipaddr"),
    netmask = uci_get("network","wan","netmask"),
    gateway = uci_get("network","wan","gateway"),
    dns = uci_get("network","wan","dns"),
    ip = trim(sh("ubus call network.interface.wan status | jsonfilter -e '@[\"ipv4-address\"][0].address'")),
  }
  return d
end

function R.wan_set()
  local proto = qs.proto or "dhcp"
  uci_set("network.wan.proto", proto)
  if proto == "pppoe" then
    if qs.username then uci_set("network.wan.username", qs.username) end
    if qs.password then uci_set("network.wan.password", qs.password) end
  elseif proto == "static" then
    if qs.ipaddr then uci_set("network.wan.ipaddr", qs.ipaddr) end
    if qs.netmask then uci_set("network.wan.netmask", qs.netmask) end
    if qs.gateway then uci_set("network.wan.gateway", qs.gateway) end
    if qs.dns then uci_set("network.wan.dns", qs.dns) end
  end
  uci_commit("network"); sh("ifup wan")
  return { ok=true }
end

-- Repeater: scan + join
function R.repeater_scan()
  local nets, seen = {}, {}
  for ifn in sh("iw dev"):gmatch("Interface (%S+)") do
    local out_s = sh("iwinfo "..ifn.." scan")
    local cur
    for line in out_s:gmatch("[^\n]+") do
      local cell = line:match("Cell %d+ %- Address: (%S+)")
      if cell then cur = { bssid=cell } end
      local essid = line:match('ESSID: "(.-)"')
      if essid and cur then cur.ssid = essid end
      local sig = line:match("Signal: (%-?%d+) dBm")
      if sig and cur then cur.signal = tonumber(sig) end
      local enc = line:match("Encryption: (%S+)")
      if enc and cur then
        cur.encryption = enc
        if cur.ssid and not seen[cur.ssid] then seen[cur.ssid]=true; nets[#nets+1]=cur end
        cur = nil
      end
    end
    if #nets > 0 then break end
  end
  return { networks=nets }
end

function R.repeater_join()
  local ssid = qs.ssid or ""
  local key  = qs.key or ""
  local enc  = qs.encryption or "psk2"
  local bssid = qs.bssid or ""
  if ssid == "" then return { ok=false, error="missing ssid" } end
  -- create sta interface
  local radio = trim(sh("uci -q get wireless.@wifi-iface[0].radio")); radio = radio ~= "" and radio or "radio0"
  sh("uci -q delete wireless.wwan")
  uci_set("wireless.wwan", "wifi-iface")
  uci_set("wireless.wwan.device", radio)
  uci_set("wireless.wwan.mode", "sta")
  uci_set("wireless.wwan.ssid", ssid)
  uci_set("wireless.wwan.network", "wwan")
  uci_set("wireless.wwan.encryption", enc)
  if key ~= "" then uci_set("wireless.wwan.key", key) end
  if bssid ~= "" then uci_set("wireless.wwan.bssid", bssid) end
  uci_commit("wireless")
  sh("uci -q delete network.wwan")
  uci_set("network.wwan", "interface")
  uci_set("network.wwan.proto", "dhcp")
  uci_commit("network")
  sh("wifi reload"); sh("ifup wwan")
  return { ok=true }
end

-- USB modem uplink
function R.modem()
  return {
    enabled = uci_get("wrtweb","usbmodem","enabled"),
    proto = uci_get("wrtweb","usbmodem","proto"),
    apn = uci_get("wrtweb","usbmodem","apn"),
    detected = trim(sh("ls /dev/cdc-wdm* /dev/ttyUSB* 2>/dev/null | head -1")),
  }
end

function R.modem_set()
  uci_set("wrtweb.usbmodem.enabled", qs.enabled or "1")
  if qs.proto then uci_set("wrtweb.usbmodem.proto", qs.proto) end
  if qs.apn then uci_set("wrtweb.usbmodem.apn", qs.apn) end
  uci_commit("wrtweb")
  sh("/usr/libexec/wrtweb/usbmodem.sh apply")
  return { ok=true }
end

-- Guest network apply (delegates to the guest.sh helper)
function R.guest_apply()
  if qs.ssid then uci_set("wrtweb.guest.ssid", qs.ssid) end
  if qs.key then uci_set("wrtweb.guest.key", qs.key) end
  if qs.encryption then uci_set("wrtweb.guest.encryption", qs.encryption) end
  if qs.isolate then uci_set("wrtweb.guest.isolate", qs.isolate) end
  uci_set("wrtweb.guest.enabled", "1")
  uci_commit("wrtweb")
  sh("/usr/libexec/wrtweb/guest.sh apply")
  return { ok=true }
end


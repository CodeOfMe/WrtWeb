    sh("uci -q delete dhcp.@dnsmasq[0].server")
    for s in tostring(qs.servers):gmatch("[^%s,]+") do
      if s:match("^[%d%.]+$") then sh("uci add_list dhcp.@dnsmasq[0].server="..shq(s)) end
    end
    uci_commit("dhcp"); sh("/etc/init.d/dnsmasq restart")
  end
  return { ok=true }
end

-- OpenVPN profile listing
function R.ovpn()
  local files = {}
  for line in sh("ls /etc/openvpn/*.ovpn /etc/openvpn/*.conf 2>/dev/null"):gmatch("[^\n]+") do
    files[#files + 1] = line:gsub("^/etc/openvpn/", "")
  end
  return { files = files, count = #files }
end

-- WireGuard straight from UCI (netifd's wireguard proto) + live handshake state
function R.wireguard()
  local net = uci_sections("network")
  local haswg = sh("command -v wg") ~= ""
  local out = {}
  for _, n in ipairs(sorted_names(net)) do
    local s = net[n]
    if section_kind(n, s) == "interface" and s.proto == "wireguard" then
      local ifname = s.name or n
      local pub = ""
      if haswg and (s.private_key or "") ~= "" then
        pub = trim(sh("printf '%s' " .. shq(s.private_key) .. " | wg pubkey 2>/dev/null"))
      end
      local live, xfer = {}, {}
      if haswg then
        for line in sh("wg show " .. shq(ifname) .. " 2>/dev/null"):gmatch("[^\n]+") do
          local k, ep, age = line:match("^(%x+) %(([^)]*)%) (%d+)s")
          if k then live[k] = { endpoint = ep, handshake = tonumber(age) } end
        end
        for line in sh("wg show " .. shq(ifname) .. " transferred 2>/dev/null"):gmatch("[^\n]+") do
          local k, rx, tx = line:match("^(%x+) (%d+) (%d+)")
          if k then xfer[k] = { rx = tonumber(rx), tx = tonumber(tx) } end
        end
      end
      local peers = {}
      for pname in (s.peers or ""):gmatch("%S+") do
        local p = net[pname] or {}
        local key = p.public_key or ""
        local l, t = live[key] or {}, xfer[key] or {}
        peers[#peers + 1] = {
          name = pname, public_key = key, allowed_ips = p.allowed_ips or "",
          endpoint = p.endpoint or l.endpoint or "", port = p.port or "",
          handshake = l.handshake, rx = t.rx, tx = t.tx,
        }
      end
      out[#out + 1] = {
        section = n, name = ifname, public_key = pub, listen_port = s.listen_port or "",
        addresses = s.addresses or "", mtu = s.mtu or "", peers = peers,
        running = sh("ip link show " .. shq(ifname) .. " 2>/dev/null"):match("state UP") ~= nil,
      }
    end
  end
  return { interfaces = out, tools = haswg }
end

function R.wireguard_keygen()
  if sh("command -v wg") == "" then return { ok=false, error="wireguard-tools not installed" } end
  local key = trim(sh("wg genkey 2>/dev/null"))
  if key == "" then return { ok=false, error="keygen failed" } end
  return { ok=true, private_key=key, public_key=trim(sh("printf '%s' " .. shq(key) .. " | wg pubkey 2>/dev/null")) }
end

function R.wireguard_new()
  if sh("command -v wg") == "" then return { ok=false, error="wireguard-tools not installed" } end
  local name = norm_name(qs.name or "")
  if name == "" then return { ok=false, error="missing name" } end
  local key = trim(sh("wg genkey 2>/dev/null"))
  if key == "" then return { ok=false, error="keygen failed" } end
  sh("uci -q delete network." .. name .. " >/dev/null 2>&1")
  uci_set("network." .. name, "interface")
  uci_set("network." .. name .. ".proto", "wireguard")
  uci_set("network." .. name .. ".private_key", key)
  if (qs.address or "") ~= "" then sh("uci add_list network." .. name .. ".addresses=" .. shq(qs.address) .. " >/dev/null 2>&1") end
  if (qs.port or "") ~= "" then uci_set("network." .. name .. ".listen_port", qs.port) end
  uci_commit("network")
  sh("ubus call network reload 2>/dev/null")
  return { ok=true, name=name, public_key=trim(sh("printf '%s' " .. shq(key) .. " | wg pubkey 2>/dev/null")) }
end

function R.wireguard_peer()
  local iface, peer = norm_name(qs.iface or ""), norm_name(qs.peer or "")
  local key = (qs.public_key or ""):gsub("%s+", "")
  if iface == "" or peer == "" or key == "" then return { ok=false, error="missing iface / peer / public key" } end
  sh("uci -q delete network." .. peer .. " >/dev/null 2>&1")
  uci_set("network." .. peer, "wireguard_peer")
  uci_set("network." .. peer .. ".public_key", key)
  if (qs.allowed_ip or "") ~= "" then sh("uci add_list network." .. peer .. ".allowed_ips=" .. shq(qs.allowed_ip) .. " >/dev/null 2>&1") end
  if (qs.psk or "") ~= "" then uci_set("network." .. peer .. ".preshared_key", qs.psk) end
  sh("uci add_list network." .. iface .. ".peers=" .. shq(peer) .. " >/dev/null 2>&1")
  uci_commit("network")
  sh("ubus call network reload 2>/dev/null")
  return { ok=true, peer=peer }
end

function R.wireguard_del()
  local name = norm_name(qs.name or "")
  if name == "" then return { ok=false, error="missing name" } end
  local net = uci_sections("network")
  local s = net[name] or {}
  if section_kind(name, s) == "interface" then
    for pname in (s.peers or ""):gmatch("%S+") do
      sh("uci -q delete network." .. pname .. " >/dev/null 2>&1")
    end
  end
  sh("uci -q delete network." .. name .. " >/dev/null 2>&1")
  uci_commit("network")
  sh("ubus call network reload 2>/dev/null")
  return { ok=true }
end

-- static routes (netifd) - the open-source equivalent of EdgeRouter's policy routes
function R.routes()
  local net = uci_sections("network")
  local rows = {}
  for _, n in ipairs(sorted_names(net)) do
    local s = net[n]
    if section_kind(n, s) == "route" then
      rows[#rows + 1] = { section = n, interface = s.interface or "", target = s.target or "",
                          gateway = s.gateway or "", metric = s.metric or "" }
    end
  end
  local def = {}
  for line in sh("ip route show table main 2>/dev/null"):gmatch("[^\n]+") do
    if line:match("^default") then def[#def + 1] = trim(line) end
  end
  return { routes = rows, default_routes = def, policy = sh("command -v mwan3") ~= "" }
end

function R.route_add()
  local iface, target, gw, metric = norm_name(qs.interface or ""), (qs.target or ""):gsub("%s+", ""),
                                   (qs.gateway or ""):gsub("%s+", ""), (qs.metric or ""):gsub("%s+", "")
  if iface == "" or target == "" then return { ok=false, error="missing interface / target" } end
  sh("uci add network route >/dev/null 2>&1")
  local count = tonumber(trim(sh("uci -q show network | grep -c '@route\\['"))) or 0
  local sec = "@route[" .. (count - 1) .. "]"
  uci_set("network." .. sec .. ".interface", iface)
  uci_set("network." .. sec .. ".target", target)
  if gw ~= "" then uci_set("network." .. sec .. ".gateway", gw) end
  if metric ~= "" then uci_set("network." .. sec .. ".metric", metric) end
  uci_commit("network")
  sh("ubus call network reload 2>/dev/null")
  return { ok=true, section=sec }
end

function R.route_del()
  local sec = (qs.section or ""):gsub("%s+", "")
  if sec == "" then return { ok=false, error="missing section" } end
  sh("uci delete " .. shq("network." .. sec) .. " >/dev/null 2>&1")
  uci_commit("network")
  sh("ubus call network reload 2>/dev/null")
  return { ok=true }
end

-- Remote WrtWeb access from the WAN side (hosts outside the LAN subnet)
local REMOTE_RULE = "Allow-WrtWeb-WAN"
local function find_remote_rule()
  for sec, name in sh("uci show firewall 2>/dev/null"):gmatch("firewall%.([^%.]+)%.name='([^']*)'") do
    if name == REMOTE_RULE then return sec end
  end
  return nil
end

function R.remote_access()
  local sec = find_remote_rule()
  local wanip = trim(sh("ubus call network.interface.wan status | jsonfilter -e '@[\"ipv4-address\"][0].address'"))
  return { enabled = (sec ~= nil), wan_ip = wanip }
end

function R.remote_access_set()
  local sec = find_remote_rule()
  if qs.enabled == "1" then
    if not sec then
      sh("uci add firewall rule")
      uci_set("firewall.@rule[-1].name", REMOTE_RULE)
      uci_set("firewall.@rule[-1].src", "wan")
      uci_set("firewall.@rule[-1].proto", "tcp")
      uci_set("firewall.@rule[-1].dest_port", "80 443")
      uci_set("firewall.@rule[-1].target", "ACCEPT")
      uci_commit("firewall")
    else
      -- ensure no stale hard-coded source restriction remains
      sh("uci -q delete firewall."..sec..".src_ip; uci commit firewall")
    end
    uci_set("uhttpd.main.rfc1918_filter", "0"); uci_commit("uhttpd")
  else
    if sec then sh("uci delete firewall."..sec); uci_commit("firewall") end
    uci_set("uhttpd.main.rfc1918_filter", "1"); uci_commit("uhttpd")
  end
  sh("/etc/init.d/firewall reload >/dev/null 2>&1")
  sh("(sleep 2; /etc/init.d/uhttpd restart) >/dev/null 2>&1 &")
  return { ok=true }
end

-- SSH access from the WAN side

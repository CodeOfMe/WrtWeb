#!/usr/bin/lua
-- WrtWeb API backend (portable CGI).
-- Speaks JSON to the WrtWeb SPA. Uses only uci / ubus / iw / iwinfo,
-- so it works on OpenWrt 23.05 (opkg) and 24.10+/25.x (apk).
--
-- Route by query param c=<resource>. GET reads, POST mutates.
-- No external Lua deps; tiny built-in JSON encoder.

------------------------------------------------------------------
-- helpers
------------------------------------------------------------------
local function sh(cmd)
  local p = io.popen(cmd .. " 2>/dev/null")
  if not p then return "" end
  local out = p:read("*a") or ""
  p:close()
  return out
end

local function trim(s)
  local r = (s or ""):gsub("^%s+",""):gsub("%s+$","")
  return r
end

local function uci_get(cfg, sec, opt)
  return trim(sh("uci -q get "..cfg.."."..sec.."."..opt))
end

local function uci_set(spec, val)
  return sh("uci set "..spec.."="..shq(val).." >/dev/null && echo ok")
end

function shq(s)
  s = tostring(s or "")
  return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function uci_commit(cfg) sh("uci commit "..cfg) end

-- JSON encoder
local function json_escape(s)
  s = tostring(s)
  s = s:gsub('\\','\\\\'):gsub('"','\\"'):gsub('\n','\\n'):gsub('\r','\\r'):gsub('\t','\\t')
  s = s:gsub('[%z\1-\31]', function(c) return string.format('\\u%04x', c:byte()) end)
  return s
end

local function encode(v, depth)
  depth = depth or 0
  local t = type(v)
  if t == "nil" then return "null"
  elseif t == "boolean" then return v and "true" or "false"
  elseif t == "number" then
    if v ~= v then return "null" end
    return tostring(v)
  elseif t == "string" then return '"'..json_escape(v)..'"'
  elseif t == "table" then
    local isarr = true
    local n = 0
    for k,_ in pairs(v) do
      n = n + 1
      if type(k) ~= "number" then isarr = false end
    end
    if isarr and n > 0 then
      local parts = {}
      for i=1,n do parts[#parts+1] = encode(v[i], depth+1) end
      return "["..table.concat(parts, ",").."]"
    elseif n == 0 then
      return "{}"
    else
      local parts = {}
      for k,val in pairs(v) do
        parts[#parts+1] = '"'..json_escape(tostring(k))..'":'..encode(val, depth+1)
      end
      return "{"..table.concat(parts, ",").."}"
    end
  end
  return "null"
end

-- parse query string + form body into a table
local function parse_qs(s)
  local out = {}
  for k, v in (s or ""):gmatch("([^&=]+)=([^&=]*)") do
    out[k] = v:gsub("%%(%x%x)", function(h) return string.char(tonumber(h,16)) end)
                :gsub("+", " ")
  end
  return out
end

local method = os.getenv("REQUEST_METHOD") or "GET"
local qs = parse_qs(os.getenv("QUERY_STRING"))
local body = ""
if method == "POST" then
  local len = tonumber(os.getenv("CONTENT_LENGTH") or "0") or 0
  if len > 0 then body = io.read(len) or "" end
  for k,v in pairs(parse_qs(body)) do qs[k] = v end
  -- also accept raw JSON body { ... } (flat keys)
  if body:match("^%s*{") then
    for k, v in body:gmatch('"([%w_]+)"%s*:%s*"([^"]*)"') do qs[k] = v end
    for k, v in body:gmatch('"([%w_]+)"%s*:%s*([%d%-%.]+)') do qs[k] = qs[k] or v end
  end
end

local function out(tbl)
  io.write("Content-Type: application/json\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\n\r\n")
  io.write(encode(tbl))
end


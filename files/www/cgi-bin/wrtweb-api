-- Parse `uci -q show <cfg>` into { section = { key = value } }.
-- Repeated list options are joined with a space.
function R.firewall()
  local secs = uci_sections("firewall")
  local zones, rules, forwarding, defaults = {}, {}, {}, {}
  for _, name in ipairs(sorted_names(secs)) do
    local s = secs[name]
    local k = section_kind(name, s)
    if k == "zone" then
      zones[#zones + 1] = {
        idx = name, name = s.name or name, network = s.network or "",
        input = s.input or "", output = s.output or "", forward = s.forward or "",
      }
    elseif k == "rule" then
      rules[#rules + 1] = {
        idx = name, name = s.name or "", src = s.src or "", dest = s.dest or "",
        dest_port = s.dest_port or "", src_mac = s.src_mac or "",
        proto = s.proto or "", target = s.target or "ACCEPT",
      }
    elseif k == "forwarding" then
      forwarding[#forwarding + 1] = { src = s.src or "", dest = s.dest or "" }
    elseif k == "defaults" then
      defaults = {
        input = s.input or "", output = s.output or "", forward = s.forward or "",
        syn_flood = s.syn_flood or "",
      }
    end
  end
  return { zones = zones, rules = rules, forwarding = forwarding, defaults = defaults,
           rule_count = #rules }
end

function R.vlan()
  local secs = uci_sections("network")
  local devs, vlans = {}, {}
  for _, name in ipairs(sorted_names(secs)) do
    local s = secs[name]
    if s.type == "bridge" or s.type == "dsa" then
      devs[#devs + 1] = { name = s.name or name, type = s.type, ports = s.ports or "" }
    elseif s.type == "bridge-vlan" then
      vlans[#vlans + 1] = {
        name = s.name or ("vlan " .. (s.vid or "")), vid = tonumber(s.vid) or 0,
        ports = s.ports or "", aliases = s.aliases or "",
      }
    end
  end
  -- kernel 802.1Q devices that are not described in UCI
  local current
  for line in sh("ip -d link show 2>/dev/null"):gmatch("[^\n]+") do
    local _, nm = line:match("^(%d+): ([^%s:]+)")
    if nm then current = nm end
    local vid = line:match("protocol 802.1Q id (%d+)") or line:match("vlan .*vid (%d+)")
    if current and vid then
      vlans[#vlans + 1] = { name = current, vid = tonumber(vid), ports = "", aliases = "" }
    end
  end
  return { devices = devs, vlans = vlans }
end

function R.security()
  local hash = sh("grep '^root:' /etc/shadow 2>/dev/null"):match("^root:([^:]+)") or ""
  local locked = (hash == "") or (hash:match("^[*!]") ~= nil)
  local ports = {}
  for line in sh("netstat -tln 2>/dev/null"):gmatch("[^\n]+") do
    local f = {}
    for w in line:gmatch("%S+") do f[#f + 1] = w end
    if f[1] == "tcp" and f[4] then
      local addr, port = f[4]:match("^(.-):(%d+)$")
      if port then ports[#ports + 1] = { addr = addr, port = tonumber(port) } end
    end
  end
  table.sort(ports, function(a, b) return (a.port or 0) < (b.port or 0) end)
  local https_on = false
  for _, p in ipairs(ports) do if p.port == 443 then https_on = true end end
  local db = uci_sections("dropbear")
  local inst = {}
  for _, name in ipairs(sorted_names(db)) do
    local s = db[name]
    inst[#inst + 1] = {
      name = name,
      interface = s.Interface or s.interface or "all",
      port = s.Port or s.port or "22",
      enabled = s.enable or s.Enabled or "1",
      password_auth = s.PasswordAuth or s.password_auth or "",
      root_auth = s.RootPasswordAuth or s.root_password_auth or "",
    }
  end
  return {
    root_password_locked = locked,
    shell_access = inst,
    listening = ports,
    ssh_wan = R.remote_ssh().enabled,
    web_wan = R.remote_access().enabled,
    https = https_on or trim(sh("uci -q get uhttpd.main.https")) == "1",
  }
end

function R.upgrades()
  local tool = (trim(sh("command -v apk")) ~= "" and "apk") or (trim(sh("command -v opkg")) ~= "" and "opkg") or ""
  local raw = (tool == "apk" and sh_err("apk list --upgradeable"))
          or (tool == "opkg" and sh_err("opkg list-upgradable")) or ""
  local up, stale = {}, false
  for line in raw:gmatch("[^\n]+") do
    if line:match("WARNING") or line:match("No such file") then
      stale = true
    else
      local name = line:match("^(%S+)")
      local to = line:match("%->%s*(%S+)") or line:match("(%S+)%s*$")
      if name and to and name ~= to then
        up[#up + 1] = { name = name, to = to }
      end
    end
  end
  return {
    upgradable = up, count = #up, pkgtool = tool, stale = stale,
    attended = trim(sh("command -v attendedsysupgrade-cli")) ~= "",
    verify = trim(sh("uci -q get attendedsysupgrade.common.verify")) == "1",
  }
end

-- Update the package index (the Upgrade page calls this from a button)
function R.upgrades_refresh()
  local tool = (trim(sh("command -v apk")) ~= "" and "apk") or (trim(sh("command -v opkg")) ~= "" and "opkg") or ""
  if tool == "" then return { ok = false, error = "no package manager" } end
  return { ok = true, tool = tool, output = sh_err(tool .. " update") }
end

function R.backup()
  local files = {}
  for line in sh("ls /etc/config 2>/dev/null"):gmatch("[^\n]+") do files[#files + 1] = line end
  return {
    files = files, count = #files,
    keepfiles = tonumber(trim(sh("ls /lib/upgrade/keep.d 2>/dev/null | wc -l"))) or 0,
    tool = trim(sh("command -v sysupgrade")) ~= "",
    download = "/cgi-bin/wrtweb-api?c=backup_download",
  }
end

-- Build the sysupgrade archive and stream it to the browser.
function R.backup_download()
  if trim(sh("command -v sysupgrade")) == "" then
    out({ ok = false, error = "sysupgrade not available" }); return
  end
  local host = (trim(sh("cat /proc/sys/kernel/hostname")) or "openwrt"):gsub("[^%w%-_]", "")
  local path = "/tmp/wrtweb-backup-" .. host .. ".tar.gz"
  if trim(sh("sysupgrade -b " .. shq(path) .. " && echo ok")) ~= "ok" then
    out({ ok = false, error = "backup failed" }); return
  end
  local f = io.open(path, "rb")
  if not f then out({ ok = false, error = "archive not found" }); return end
  local data = f:read("*a"); f:close()
  io.write("Content-Type: application/x-gzip\r\n")
  io.write("Content-Disposition: attachment; filename=\"" .. path:match("[^/]+$") .. "\"\r\n")
  io.write("Content-Length: " .. #data .. "\r\n\r\n")
  io.write(data)
end

local function proc_num(path)
  return trim(sh("cat " .. path .. " 2>/dev/null"))
end

function R.ipv6()
  local iface = {}
  for name in sh("ubus list 'network.interface.*'"):gmatch("network%.interface%.([%w_]+)") do
    local st = sh("ubus call network.interface." .. name .. " status")
    local v6 = {}
    for a in st:gmatch('"address":%s*"([^"]+)"') do
      if a:match(":") then v6[#v6 + 1] = a end
    end
    iface[#iface + 1] = {
      name = name, up = (st:match('"up":%s*true') ~= nil),
      proto = st:match('"proto":%s*"([^"]+)"') or "",
      addr = table.concat(v6, " "),
    }
  end
  local dn = uci_sections("dhcp")["@dnsmasq[0]"] or {}
  return {
    interfaces = iface,
    ula = uci_get("network", "globals", "ula_prefix"),
    filter_aaaa = dn.filter_aaaa or "0",
    nameservers = sh("cat /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null || cat /tmp/resolv.conf 2>/dev/null"),
  }
end

function R.advanced()
  local sys = uci_sections("system")
  local s0 = sys["@system[0]"] or {}
  local dn = uci_sections("dhcp")["@dnsmasq[0]"] or {}
  local g = uci_sections("network")["globals"] or {}
  local swap_rows = 0
  for _ in sh("cat /proc/swaps 2>/dev/null"):gmatch("[^\n]+") do swap_rows = swap_rows + 1 end
  return {
    system = {
      hostname = s0.hostname or "", timezone = s0.timezone or "", zonename = s0.zonename or "",
      log_size = s0.log_size or "", log_proto = s0.log_proto or "",
      conloglevel = s0.conloglevel or "", cronloglevel = s0.cronloglevel or "",
      ttylogin = s0.ttylogin or "0",
    },
    ntp = (sys["ntp"] or {}).server or "",
    dns = {
      domain = dn.domain or "", cachesize = dn.cachesize or "",
      rebind = dn.rebind_protection or "", expandhosts = dn.expandhosts or "",
      filter_aaaa = dn.filter_aaaa or "", localnet = dn["local"] or "",
    },
    globals = { ula_prefix = g.ula_prefix or "", irqmode = g.irqmode or "" },
    sysctl = {
      swappiness = proc_num("/proc/sys/vm/swappiness"),
      netdev_budget = proc_num("/proc/sys/net/core/netdev_budget"),
      backlog = proc_num("/proc/sys/net/core/netdev_max_backlog"),
    },
    swap = swap_rows > 1,
    irqbalance = trim(sh("command -v irqbalance")) ~= "",
    load = trim(sh("cut -d' ' -f1-3 /proc/loadavg 2>/dev/null")),
  }
end

-- Ping diagnostics (Advanced page)
function R.diagnostics()
  local target = (qs.host or "")
  if target == "" then target = sh("ip route 2>/dev/null"):match("default via (%S+)") or "" end
  target = (target or ""):gsub("[^%w%.:%-]", "")
  if target == "" then return { ok = false, error = "no target" } end
  local out = sh_err("ping -c 3 -W 3 " .. shq(target))
  local tx, rx, loss = out:match("(%d+) packets transmitted, (%d+) packets received, (%d+)%% packet loss")
  local mn, av, mx = out:match("min/avg/max = ([%d%.]+)/([%d%.]+)/([%d%.]+)")
  return {
    ok = true, host = target,
    transmitted = tonumber(tx) or 0, received = tonumber(rx) or 0,
    loss = tonumber(loss) or 100,
    min = tonumber(mn) or 0, avg = tonumber(av) or 0, max = tonumber(mx) or 0,
  }
end

-- Parental control: one firewall rule per device MAC.
local PARENT_PREFIX = "Parental-"

local function norm_mac(s)
  s = tostring(s or ""):upper()
  if #s == 17 and s:match("^[%x:]+$") then return s end
  return nil
end

local function parental_rule(mac)
  for name, s in pairs(uci_sections("firewall")) do
    if section_kind(name, s) == "rule" and (s.src_mac or ""):upper() == mac then return name end
  end
  return nil
end

function R.parental()
  local blocked = {}
  for name, s in pairs(uci_sections("firewall")) do
    if section_kind(name, s) == "rule" and (s.name or ""):match("^" .. PARENT_PREFIX) then
      blocked[(s.src_mac or ""):upper()] = name
    end
  end
  local rows = {}
  for _, c in ipairs(R.clients().clients) do
    rows[#rows + 1] = {
      mac = c.mac, ip = c.ip, name = c.name, source = c.source,
      blocked = blocked[(c.mac or ""):upper()] ~= nil,
    }
  end
  return { clients = rows }
end

function R.parental_block()
  local mac = norm_mac(qs.mac)
  if not mac then return { ok = false, error = "bad mac" } end
  if not parental_rule(mac) then
    sh("uci add firewall rule")
    uci_set("firewall.@rule[-1].name", PARENT_PREFIX .. mac)
    uci_set("firewall.@rule[-1].src", qs.zone or "lan")
    uci_set("firewall.@rule[-1].src_mac", mac)
    uci_set("firewall.@rule[-1].dest", "*")
    uci_set("firewall.@rule[-1].proto", "all")
    uci_set("firewall.@rule[-1].target", "REJECT")
    uci_commit("firewall")
  end
  sh("/etc/init.d/firewall reload >/dev/null 2>&1")
  return { ok = true }
end

function R.parental_unblock()
  local mac = norm_mac(qs.mac)
  if not mac then return { ok = false, error = "bad mac" } end
  local sec = parental_rule(mac)
  if sec then
    sh("uci delete " .. shq("firewall." .. sec))
    uci_commit("firewall")
    sh("/etc/init.d/firewall reload >/dev/null 2>&1")
  end
  return { ok = true }
end

